{
  "name": "@couju/server",
  "version": "0.1.0",
  "private": true,
  "description": "算我一个 API：Hono + Node 内置 SQLite（本地开发/自托管）。CloudBase 适配见 README。",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import:legacy": "tsx src/import-legacy-cli.ts"
  },
  "dependencies": {
    "@couju/core": "*",
    "@hono/node-server": "^1.19.5",
    "hono": "^4.10.4",
    "luxon": "^3.7.2",
    "nodemailer": "^10.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.6",
    "vitest": "^4.0.5"
  }
}
