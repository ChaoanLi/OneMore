# 复制为项目根目录的 .env（已在 .gitignore 中），API 服务启动时自动读取
# API 端口（npm start 同时提供 H5 页面）
PORT=8787
# SQLite 数据文件；默认 apps/server/data/couju.db
# DB_PATH=/absolute/path/couju.db

# AI 组局：不填 DEEPSEEK_API_KEY 时使用演示解析（关键词规则，不是 AI）
# API Key 只放在后端，绝不放进前端代码
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# 强制使用演示解析：AI_PROVIDER=mock

# 部署用：Caddy 为这个域名自动申请 HTTPS 证书（见 docs/DEPLOY.md）
# DOMAIN=onemore.chaoanli.com

# 公网地址：邮件和日历订阅里的链接会用它（部署后务必填写）
# PUBLIC_URL=https://onemore.example.com

# 邮件（SMTP）。不填 = 演示模式：邮件只打印在服务器日志，验证码直接显示在页面上
# QQ 邮箱：在 QQ 邮箱“设置 → 账号”里开启 SMTP 并生成授权码（不是 QQ 密码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的QQ号@qq.com
# SMTP_PASS=授权码
# MAIL_FROM=算我一个 <你的QQ号@qq.com>
#
# 163 邮箱：SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_PASS=客户端授权码
# Gmail：SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_PASS=应用专用密码（需开启两步验证）
# Outlook：SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
